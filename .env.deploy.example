# Copy to .env.deploy (gitignored) and fill in — used by `npm run deploy`.
# hPanel → Files → FTP Accounts: the account whose directory is the docall folder.
FTP_HOST=
FTP_USER=
FTP_PASSWORD=
# Folder on the server, as the FTP account sees it ("/" = the account's own folder)
FTP_DIR=/
# Encrypted FTP (default). Set FTP_TLS=false only if Hostinger refuses FTPS.
FTP_TLS=true
# Set true if you get a certificate error because FTP_HOST is an IP address
FTP_TLS_INSECURE=false
